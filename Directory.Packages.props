<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia. Пакеты фреймворка выпускаются одной версией и поднимаются только вместе -->
    <PackageVersion Include="Avalonia" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <!-- Подключение Avalonia DevTools, только в Debug -->
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- MVVM -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Трей: иконка с обработкой средней кнопки и уведомлениями; System.Drawing.Common —
         загрузка кадра нужного размера из app.ico -->
    <PackageVersion Include="H.NotifyIcon" Version="2.4.1" />
    <PackageVersion Include="System.Drawing.Common" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- Инструменты: сборка app.ico из SVG (assets/icon/build-icon.cs) -->
    <PackageVersion Include="Svg.Skia" Version="5.2.3" />
  </ItemGroup>
</Project>
