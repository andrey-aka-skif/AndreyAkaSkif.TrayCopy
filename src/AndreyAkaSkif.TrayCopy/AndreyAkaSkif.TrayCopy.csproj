<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Значок exe. Собирается из SVG скриптом assets/icon/build-icon.cs -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Код, генерируемый для LibraryImport (вызовы Win32 API), использует unsafe -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Win32" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.HarfBuzz" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="H.NotifyIcon" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="System.Drawing.Common" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <!-- Типы приложения internal; тесты обращаются к ним напрямую -->
    <InternalsVisibleTo Include="AndreyAkaSkif.TrayCopy.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Лицензия приложения и лицензии сторонних компонентов лежат рядом с exe: их открывает
         окно «О программе». Расширение .txt — чтобы файл открывался двойным щелчком -->
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Уведомления о стороннем коде внутри среды .NET и пакетов попадают в публикацию в папку
       licenses. Берутся из пакетов тех версий, что публикуются; пропавший файл — ошибка, а не
       тихая потеря уведомления. Новая зависимость с таким файлом — строка здесь и запись в
       THIRD-PARTY-NOTICES.txt. SDK разрешает пакеты и других сред (WindowsDesktop,
       AspNetCore), но в поставку входит только Microsoft.NETCore.App -->
  <Target Name="PublishThirdPartyNotices" AfterTargets="Publish">
    <PropertyGroup>
      <!-- Корень, заданный через NUGET_PACKAGES, NuGet оставляет как есть, без завершающего
           слэша: так в CI -->
      <_NuGetPackageRoot>$([MSBuild]::EnsureTrailingSlash('$(NuGetPackageRoot)'))</_NuGetPackageRoot>
    </PropertyGroup>

    <ItemGroup>
      <_PackageAsset Include="@(RuntimeCopyLocalItems);@(NativeCopyLocalItems)" />
      <_ThirdPartyNotices Include="@(ResolvedRuntimePack->WithMetadataValue('FrameworkName', 'Microsoft.NETCore.App')->'%(PackageDirectory)\THIRD-PARTY-NOTICES.TXT')"
                          TargetName="dotnet" />
      <_ThirdPartyNotices Include="@(_PackageAsset->WithMetadataValue('NuGetPackageId', 'System.Drawing.Common')->'$(_NuGetPackageRoot)system.drawing.common\%(NuGetPackageVersion)\THIRD-PARTY-NOTICES.TXT'->Distinct())"
                          TargetName="system.drawing.common" />
      <_ThirdPartyNotices Include="@(_PackageAsset->WithMetadataValue('NuGetPackageId', 'SkiaSharp.NativeAssets.Win32')->'$(_NuGetPackageRoot)skiasharp.nativeassets.win32\%(NuGetPackageVersion)\THIRD-PARTY-NOTICES.txt'->Distinct())"
                          TargetName="skiasharp" />
      <_ThirdPartyNotices Include="@(_PackageAsset->WithMetadataValue('NuGetPackageId', 'HarfBuzzSharp.NativeAssets.Win32')->'$(_NuGetPackageRoot)harfbuzzsharp.nativeassets.win32\%(NuGetPackageVersion)\THIRD-PARTY-NOTICES.txt'->Distinct())"
                          TargetName="harfbuzzsharp" />
      <_ThirdPartyNotices Include="@(_PackageAsset->WithMetadataValue('NuGetPackageId', 'CommunityToolkit.Mvvm')->'$(_NuGetPackageRoot)communitytoolkit.mvvm\%(NuGetPackageVersion)\ThirdPartyNotices.txt'->Distinct())"
                          TargetName="communitytoolkit.mvvm" />
      <_ThirdPartyNoticesName Include="dotnet;system.drawing.common;skiasharp;harfbuzzsharp;communitytoolkit.mvvm" />
      <_ThirdPartyNoticesMissing Include="@(_ThirdPartyNoticesName)"
                                 Exclude="@(_ThirdPartyNotices->'%(TargetName)')" />
    </ItemGroup>

    <Error Condition="'@(_ThirdPartyNoticesMissing)' != ''"
           Text="Не найден пакет с уведомлениями о стороннем коде: @(_ThirdPartyNoticesMissing)" />
    <Error Condition="!Exists('%(_ThirdPartyNotices.Identity)')"
           Text="Нет файла уведомлений о стороннем коде: %(_ThirdPartyNotices.Identity)" />

    <Copy SourceFiles="@(_ThirdPartyNotices)"
          DestinationFiles="@(_ThirdPartyNotices->'$(PublishDir)licenses\%(TargetName).txt')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
