<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:AndreyAkaSkif.TrayCopy"
        x:Class="AndreyAkaSkif.TrayCopy.Views.AboutWindow"
        x:ClassModifier="internal"
        Title="О программе"
        Icon="/Assets/app.ico"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <!-- Ссылки выровнены по краю текста, как строки рядом -->
        <Style Selector="HyperlinkButton">
            <Setter Property="Padding" Value="0" />
        </Style>
    </Window.Styles>

    <StackPanel Margin="24,20" Spacing="16" MinWidth="320">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
            <Image Source="/Assets/app.ico"
                   Width="48"
                   Height="48"
                   RenderOptions.BitmapInterpolationMode="HighQuality" />
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="TrayCopy" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Source={x:Static app:AppInfo.Version}, StringFormat='Версия {0}'}"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}" />
            </StackPanel>
        </Grid>

        <StackPanel Spacing="6">
            <TextBlock Text="{x:Static app:AppInfo.Copyright}" />
            <HyperlinkButton Content="Лицензия MIT" Click="OnLicenseClick" />
            <HyperlinkButton Content="Сторонние компоненты" Click="OnThirdPartyNoticesClick" />
            <HyperlinkButton Content="{x:Static app:AppInfo.RepositoryUrl}"
                             NavigateUri="{x:Static app:AppInfo.RepositoryUrl}" />
        </StackPanel>

        <Button Content="Закрыть"
                HorizontalAlignment="Right"
                IsDefault="True"
                IsCancel="True"
                Click="OnCloseClick" />
    </StackPanel>
</Window>
