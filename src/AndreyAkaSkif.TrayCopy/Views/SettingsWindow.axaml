<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:AndreyAkaSkif.TrayCopy"
        xmlns:vm="using:AndreyAkaSkif.TrayCopy.ViewModels"
        xmlns:views="using:AndreyAkaSkif.TrayCopy.Views"
        x:Class="AndreyAkaSkif.TrayCopy.Views.SettingsWindow"
        x:ClassModifier="internal"
        x:DataType="vm:SettingsViewModel"
        Title="{Binding Source={x:Static app:AppInfo.Version}, StringFormat='TrayCopy {0}'}"
        Icon="/Assets/app.ico"
        Width="640"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <views:FractionToAngleConverter x:Key="FractionToAngle" />
    </Window.Resources>

    <Grid RowDefinitions="*,Auto" Margin="16">

        <StackPanel Spacing="10">
            <!-- Настройки при запуске не прочитались. Отложенный файл лежит рядом с
                 settings.json, поэтому показано только его имя, а папка открывается кнопкой -->
            <Border IsVisible="{Binding BackupFileName, Converter={x:Static ObjectConverters.IsNotNull}}"
                    BorderBrush="{DynamicResource SystemControlErrorTextForegroundBrush}"
                    Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,8">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <TextBlock Text="⚠"
                               Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="Прежние настройки не удалось прочитать. Они сохранены в файл"
                                   TextWrapping="Wrap" />
                        <SelectableTextBlock Text="{Binding BackupFileName}" TextWrapping="Wrap" />
                        <Button Content="Открыть папку"
                                HorizontalAlignment="Right"
                                Click="OnOpenBackupFolderClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="Записи" FontWeight="SemiBold" />

            <!-- Выделения строк нет: действия над строкой — кнопками в ней самой, а единственная
                 отметка в списке — текущая запись -->
            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    CornerRadius="{DynamicResource ControlCornerRadius}"
                    Padding="8">
                <Border.Styles>
                    <!-- Высота кнопки — как у поля, а не по высоте строки шрифта. Тема Fluent не
                         центрирует содержимое кнопки: при заданных размерах значок прижат влево
                         и кверху. Отступов нет: у Fluent они несимметричны и сдвигают значок -->
                    <Style Selector="Button.entryAction">
                        <Setter Property="Width" Value="32" />
                        <Setter Property="Height" Value="32" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="VerticalAlignment" Value="Top" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
                    </Style>
                    <!-- Значки — из системного шрифта значков: Segoe Fluent Icons в Windows 11,
                         Segoe MDL2 Assets в Windows 10, коды у них общие. Символы обычных шрифтов
                         приходят из разных шрифтов замены и стоят на разной высоте. Шрифт задан
                         содержимому, а не кнопке: подсказку он не затрагивает -->
                    <Style Selector="Button.entryAction /template/ ContentPresenter#PART_ContentPresenter">
                        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        <Setter Property="FontSize" Value="12" />
                    </Style>
                    <!-- Полоса прокрутки видна всегда, а когда прокручивать нечего, недоступна;
                         признак scrollable ставит окно -->
                    <Style Selector="ScrollViewer#EntryScroll:not(.scrollable) /template/ ScrollBar#PART_VerticalScrollBar">
                        <Setter Property="IsEnabled" Value="False" />
                    </Style>
                </Border.Styles>

                <!-- Полоса прокрутки не ложится поверх строк, а занимает место справа. На ту же
                     ширину окно сдвигает нижнюю строку: её кнопки остаются в колонке кнопок
                     строк -->
                <StackPanel Spacing="6">
                    <ScrollViewer x:Name="EntryScroll"
                                  MaxHeight="320"
                                  AllowAutoHide="False"
                                  VerticalScrollBarVisibility="Visible">
                        <!-- Tab проходит строки по порядку. Строки создаются все сразу: обход
                             идёт по визуальному дереву и не видит строк, не созданных
                             виртуализацией -->
                        <ItemsControl x:Name="EntryList" ItemsSource="{Binding Entries}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:EntryViewModel">
                                    <!-- Элементы прижаты к верху: ошибка под одним полем не
                                         растягивает соседние по высоте строки -->
                                    <Grid ColumnDefinitions="Auto,160,*,Auto" ColumnSpacing="8">
                                        <RadioButton Grid.Column="0"
                                                     VerticalAlignment="Top"
                                                     MinHeight="32"
                                                     Padding="0"
                                                     IsChecked="{Binding IsCurrent}"
                                                     ToolTip.Tip="Текущая запись: её копирует клик по иконке в трее" />
                                        <TextBox Grid.Column="1"
                                                 VerticalAlignment="Top"
                                                 Text="{Binding Name}"
                                                 PlaceholderText="Имя" />
                                        <TextBox Grid.Column="2"
                                                 VerticalAlignment="Top"
                                                 Text="{Binding Value}"
                                                 PlaceholderText="Значение"
                                                 PasswordChar="•"
                                                 Classes="revealPasswordButton" />
                                        <!-- Классы moveUp, moveDown и remove нужны окну: после
                                             действия оно возвращает фокус и курсор к строке -->
                                        <StackPanel Grid.Column="3"
                                                    Orientation="Horizontal"
                                                    Spacing="4">
                                            <Button Classes="entryAction moveUp"
                                                    Content="&#xE74A;"
                                                    Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).MoveUpCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Переместить выше" />
                                            <Button Classes="entryAction moveDown"
                                                    Content="&#xE74B;"
                                                    Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).MoveDownCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Переместить ниже" />
                                            <Button Classes="entryAction remove"
                                                    Content="&#xE711;"
                                                    Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RemoveCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Удалить запись" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Нижняя строка есть всегда: сообщение об удалении не меняет высоту окна.
                         Удалённую строку можно вернуть до сохранения; строки возвращаются в
                         обратном порядке -->
                    <Grid x:Name="EntryFooter" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Text="{Binding RemovedEntryMessage}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <!-- Пустое место под «↑»: кнопки встают под «↓» и «✕» -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <Panel Width="32" />
                            <Button Classes="entryAction"
                                    Content="&#xE7A7;"
                                    Command="{Binding UndoRemoveCommand}"
                                    ToolTip.Tip="Вернуть удалённую запись на прежнее место" />
                            <Button x:Name="AddButton"
                                    Classes="entryAction"
                                    Content="&#xE710;"
                                    Command="{Binding AddCommand}"
                                    ToolTip.Tip="Добавить запись" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="Настройки" FontWeight="SemiBold" Margin="0,8,0,0" />

            <CheckBox Content="Обрезать пробелы по краям при сохранении"
                      IsChecked="{Binding TrimWhitespace}" />

            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock Text="Уведомление:" VerticalAlignment="Center" />
                <RadioButton GroupName="Notification"
                             Content="своё окно"
                             IsChecked="{Binding IsPopupNotification}" />
                <RadioButton GroupName="Notification"
                             Content="системное"
                             IsChecked="{Binding IsSystemNotification}" />
            </StackPanel>

            <CheckBox Content="Шифровать значения (DPAPI)" IsChecked="{Binding IsProtected}" />
            <CheckBox Content="Запускать при входе в Windows"
                      IsChecked="{Binding IsAutostartEnabled}" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Показывать окно при запуске, с:" VerticalAlignment="Center" />
                <NumericUpDown Value="{Binding StartupDisplaySeconds}"
                               Minimum="{x:Static vm:SettingsViewModel.MinStartupDisplaySeconds}"
                               Maximum="{x:Static vm:SettingsViewModel.MaxStartupDisplaySeconds}"
                               Increment="1"
                               FormatString="0"
                               ParsingNumberStyle="Integer"
                               Width="120"
                               ToolTip.Tip="Если записей нет, окно при запуске открывается всегда и не скрывается" />
                <TextBlock Text="0 — не показывать"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                       Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- Панель кнопок окна объявлена после настроек: Tab обходит элементы в порядке
             разметки -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,16,0,0">
            <Button Grid.Column="0" Content="Выйти из приложения" Command="{Binding ExitCommand}" />
            <HyperlinkButton Grid.Column="1"
                             Content="О программе"
                             VerticalAlignment="Center"
                             Margin="8,0,0,0"
                             Click="OnAboutClick" />

            <!-- Отсчёт до скрытия окна, показанного при запуске: сектор убывает по часовой
                 стрелке от верхней точки -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="6"
                        IsVisible="{Binding Countdown.IsRunning}"
                        ToolTip.Tip="Клик или клавиша в окне оставят его открытым">
                <Panel Width="18" Height="18">
                    <Ellipse Stroke="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                             StrokeThickness="1" />
                    <!-- Толщина линии — половина размера: дуга заливает сектор до центра -->
                    <Arc StartAngle="-90"
                         SweepAngle="{Binding Countdown.RemainingFraction, Converter={StaticResource FractionToAngle}}"
                         Stroke="{DynamicResource SystemControlHighlightAccentBrush}"
                         StrokeThickness="9" />
                </Panel>
                <TextBlock VerticalAlignment="Center"
                           Text="{Binding Countdown.RemainingSeconds, StringFormat='{}{0} с'}" />
            </StackPanel>

            <Button Grid.Column="3"
                    Classes="accent"
                    Content="Сохранить"
                    Command="{Binding SaveCommand}"
                    Margin="0,0,8,0" />
            <Button Grid.Column="4"
                    Content="Отмена"
                    Command="{Binding CancelCommand}"
                    IsCancel="True" />
        </Grid>
    </Grid>
</Window>
