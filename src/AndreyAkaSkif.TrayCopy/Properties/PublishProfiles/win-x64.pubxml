<Project>

  <!-- Публикация для установщика (installer/AndreyAkaSkif.TrayCopy.iss):
       dotnet publish src/AndreyAkaSkif.TrayCopy -p:PublishProfile=win-x64
       Приложение несёт среду .NET с собой: у пользователя её может не быть.
       Один файл: сборки приложения, библиотек и среды упакованы в exe и загружаются из него
       без распаковки. Нативные библиотеки (Skia, HarfBuzz, ANGLE) лежат рядом с exe: с
       IncludeNativeLibrariesForSelfExtract они распаковывались бы при запуске в %TEMP%\.net.
       Сжатия сборок в exe нет: установщик сжимает и так, а распаковка в память замедлила бы
       запуск -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\artifacts\publish\win-x64\</PublishDir>
  </PropertyGroup>

</Project>
