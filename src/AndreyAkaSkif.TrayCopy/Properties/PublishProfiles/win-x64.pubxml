<Project>

  <!-- Публикация для установщика (installer/AndreyAkaSkif.TrayCopy.iss):
       dotnet publish src/AndreyAkaSkif.TrayCopy -p:PublishProfile=win-x64
       Приложение несёт среду .NET с собой: у пользователя её может не быть.
       Папка, а не один файл: установщик всё равно раскладывает файлы по каталогу,
       а нативные библиотеки Avalonia в single-file распаковывались бы во временную папку -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\artifacts\publish\win-x64\</PublishDir>
  </PropertyGroup>

</Project>
