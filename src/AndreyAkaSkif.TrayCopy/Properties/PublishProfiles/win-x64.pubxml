<Project>

  <!-- Публикация для установщика (installer/AndreyAkaSkif.TrayCopy.iss):
       dotnet publish src/AndreyAkaSkif.TrayCopy -p:PublishProfile=win-x64
       Приложение несёт среду .NET с собой: у пользователя её может не быть.
       Native AOT: приложение компилируется в машинный код при публикации и работает без JIT —
       окно появляется быстрее, а в простое приложение занимает меньше памяти. AOT
       подразумевает тримминг и один файл: из среды и библиотек остаётся только код, который
       приложение использует, и всё это входит в exe. Предупреждения тримминга и AOT
       (IL2xxx, IL3xxx) означают код, который после компиляции может сломаться, и в публикации
       их быть не должно. Нативные библиотеки (Skia, HarfBuzz, ANGLE) лежат рядом с exe.
       Для компоновки нужен MSVC — рабочая нагрузка Visual Studio «Desktop development
       with C++» (см. CONTRIBUTING.md) -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\artifacts\publish\win-x64\</PublishDir>
  </PropertyGroup>

</Project>
