<Project>

  <!-- Публикация для установщика без среды .NET (iscc /DFrameworkDependent):
       dotnet publish src/AndreyAkaSkif.TrayCopy -p:PublishProfile=win-x64-framework-dependent
       Среду .NET 10 (Microsoft.NETCore.App) берёт из системы. Один файл, как и в профиле
       win-x64: в exe только сборки приложения и библиотек, нативные библиотеки рядом с ним -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\artifacts\publish\win-x64-framework-dependent\</PublishDir>
  </PropertyGroup>

</Project>
